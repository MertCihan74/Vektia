# ============================================
# Vektia Configuration
# ============================================

# --- Application ---
VEKTIA_APP_NAME=Vektia
VEKTIA_VERSION=0.1.0
VEKTIA_DEBUG=true
VEKTIA_HOST=0.0.0.0
VEKTIA_PORT=8000

# --- Redis ---
VEKTIA_REDIS_URL=redis://localhost:6379/0
VEKTIA_REDIS_MAX_CONNECTIONS=50

# --- Database (SQLite for MVP) ---
VEKTIA_DATABASE_URL=sqlite+aiosqlite:///./vektia.db

# --- JWT Auth ---
VEKTIA_JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
VEKTIA_JWT_ALGORITHM=HS256
VEKTIA_JWT_EXPIRATION_MINUTES=1440

# --- Admin Default Credentials (First Run Only) ---
VEKTIA_ADMIN_USERNAME=admin
VEKTIA_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# --- API Keys ---
VEKTIA_MASTER_API_KEY=CHANGE_ME_TO_A_RANDOM_API_KEY

# --- Detection Thresholds (zaman eşikleri MİLİSANİYE cinsindendir) ---
VEKTIA_MAX_WINDOW=20
VEKTIA_BOT_THRESHOLD=3.0
VEKTIA_SUSPICIOUS_THRESHOLD=15.0
VEKTIA_PLAYER_TTL_SECONDS=300
VEKTIA_ML_BATCH_INTERVAL_SECONDS=30

# --- Temporal Evidence (Yanlış Pozitif Azaltma) ---
VEKTIA_TEMPORAL_ENABLED=true
VEKTIA_TEMPORAL_DECAY_FACTOR=0.6
VEKTIA_TEMPORAL_HIGH_INCREMENT=1.0
VEKTIA_TEMPORAL_SUSPICIOUS_INCREMENT=0.4
VEKTIA_TEMPORAL_SUSPECT_THRESHOLD=0.8
# 1.9: HIGH kanıt asimptotu 1.0/(1-0.6)=2.5'tir; eşik bunun ALTINDA olmalı,
# yoksa sürdürülen HIGH asla confirm üretmez (temporal CONFIRMED ölü kod olur).
VEKTIA_TEMPORAL_CONFIRM_THRESHOLD=1.9
VEKTIA_TEMPORAL_TTL_SECONDS=120

# --- Per-Player Baseline & Trust (Faz 3 — Yanlış Pozitif Azaltma) ---
# Uzun süre temiz oynayan oyuncuya güven biriktir; güvenilenin şüpheli pencereleri
# zamansal kanıta daha az katkı yapar (leniency) → kalıcı gerçek oyuncuda FP düşer.
VEKTIA_BASELINE_ENABLED=true
VEKTIA_BASELINE_EMA_DECAY=0.95
VEKTIA_BASELINE_MIN_SAMPLES=50
VEKTIA_BASELINE_TRUST_LENIENCY=0.6
VEKTIA_BASELINE_TTL_SECONDS=86400

# --- Shadow Mode / Ölçüm (Faz 4 — Kalibrasyon) ---
# true: pipeline kararı hesaplar ama AKSİYON ALMAZ (flag/ML/ban yok), yalnızca
# "ne yapardım" sayaçlarını işler. Yeni eşikleri canlıda güvenle ölçmek için.
VEKTIA_SHADOW_MODE=false

# --- Ban Settings ---
VEKTIA_AUTO_BAN_ENABLED=false
VEKTIA_BAN_REQUIRES_ADMIN_APPROVAL=true

# --- Webhook ---
VEKTIA_WEBHOOK_TIMEOUT_SECONDS=10
VEKTIA_WEBHOOK_MAX_RETRIES=3
